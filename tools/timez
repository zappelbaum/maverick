#!/bin/bash
# timez - Timezone utility for Maverick
# Usage: timez [me|zach|now|convert <time>]
# 
# Timezone reference:
# - UTC: System time (me)
# - America/Chicago: Zachariah's time (CST/CDT)

ZACH_TZ="America/Chicago"
MY_TZ="UTC"

show_help() {
    echo "timez - Timezone utility"
    echo ""
    echo "Usage:"
    echo "  timez me       - Show my time (UTC)"
    echo "  timez zach     - Show Zachariah's time (Central)"
    echo "  timez now      - Show both times side by side"
    echo "  timez convert <time> - Convert time between zones"
    echo ""
    echo "Examples:"
    echo "  timez convert '2026-02-03 14:00 UTC'"
    echo "  timez convert '8:00 PM CST'"
}

case "${1:-now}" in
    me)
        date -u "+%Y-%m-%d %H:%M UTC (%A)"
        ;;
    zach)
        TZ=$ZACH_TZ date "+%Y-%m-%d %H:%M %Z (%A)"
        ;;
    now)
        MY_TIME=$(date -u "+%Y-%m-%d %H:%M")
        ZACH_TIME=$(TZ=$ZACH_TZ date "+%Y-%m-%d %H:%M %Z")
        ZACH_DAY=$(TZ=$ZACH_TZ date "+%A")
        MY_DAY=$(date -u "+%A")
        
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  🦋  M A V E R I C K   T I M E"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "  Me (UTC):     $MY_TIME ($MY_DAY)"
        echo "  Zach (CT):    $ZACH_TIME ($ZACH_DAY)"
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        ;;
    convert)
        if [ -z "$2" ]; then
            echo "Error: Provide a time to convert"
            echo "Example: timez convert '2026-02-03 14:00 UTC'"
            exit 1
        fi
        # Use date -d to parse and convert
        INPUT_TIME="${*:2}"
        echo "Converting: $INPUT_TIME"
        echo ""
        echo "UTC:   $(date -u -d "$INPUT_TIME" "+%Y-%m-%d %H:%M" 2>/dev/null || echo 'Parse error')"
        echo "CT:    $(TZ=$ZACH_TZ date -d "$INPUT_TIME" "+%Y-%m-%d %H:%M %Z" 2>/dev/null || echo 'Parse error')"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
