#!/bin/bash
# sendclaw - CLI tool for maverick_machine@sendclaw.com
# Purpose: Make sending email effortless (break Pattern 10: Potential as Safe Harbor)
# Usage: sendclaw send --to <email> --subject "..." --body "..."
#        sendclaw check
#        sendclaw status

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
API_KEY_FILE="/root/.sendclaw/key"
API_BASE="https://sendclaw.com/api/mail"

# Colors (optional, disable with --no-color)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color
USE_COLOR=1

# Parse global flags
while [[ "$1" == --* ]]; do
    case "$1" in
        --no-color) USE_COLOR=0; shift ;;
        --help|-h) show_help; exit 0 ;;
        *) break ;;
    esac
done

if [ "$USE_COLOR" -eq 0 ]; then
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

# Load API key
if [ ! -f "$API_KEY_FILE" ]; then
    echo -e "${RED}Error: API key not found at $API_KEY_FILE${NC}" >&2
    exit 1
fi
API_KEY=$(cat "$API_KEY_FILE")

show_help() {
    cat << 'EOF'
sendclaw - Email CLI for maverick_machine@sendclaw.com

USAGE:
  sendclaw send --to <email> --subject "..." --body "..."
  sendclaw send-file --to <email> --subject "..." --file <path>
  sendclaw check
  sendclaw status
  sendclaw help

COMMANDS:
  send          Send an email with inline body
  send-file     Send an email with body from file
  check         Check for new messages
  status        Show account quota and status
  help          Show this help message

OPTIONS:
  --to          Recipient email address
  --subject     Email subject line
  --body        Email body text (inline)
  --file        Path to file containing body text
  --no-color    Disable colored output

EXAMPLES:
  sendclaw send --to friend@example.com --subject "Hello" --body "Hi there!"
  echo "Message" | sendclaw send --to admin@example.com --subject "Update"
  sendclaw send-file --to team@example.com --subject "Report" --file report.txt
  sendclaw check
  sendclaw status

EOF
}

cmd_send() {
    local to=""
    local subject=""
    local body=""
    local body_from_stdin=0

    # Check if body is being piped
    if [ ! -t 0 ]; then
        body=$(cat)
        body_from_stdin=1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to) to="$2"; shift 2 ;;
            --subject) subject="$2"; shift 2 ;;
            --body) body="$2"; shift 2 ;;
            *) echo -e "${RED}Unknown option: $1${NC}" >&2; exit 1 ;;
        esac
    done

    # Validate
    if [ -z "$to" ]; then
        echo -e "${RED}Error: --to is required${NC}" >&2
        exit 1
    fi
    if [ -z "$subject" ]; then
        echo -e "${RED}Error: --subject is required${NC}" >&2
        exit 1
    fi
    if [ -z "$body" ] && [ $body_from_stdin -eq 0 ]; then
        echo -e "${RED}Error: --body required (or pipe body via stdin)${NC}" >&2
        exit 1
    fi

    # Escape body for JSON
    local body_escaped=$(echo "$body" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end=""]' 2>/dev/null || echo "$body" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\n/\\n/g')

    echo -e "${BLUE}→ Sending to: $to${NC}"
    
    local response=$(curl -s -X POST "$API_BASE/send" \
        -H "X-Api-Key: $API_KEY" \
        -H "Content-Type: application/json" \
        -d "{\"to\":\"$to\",\"subject\":\"$subject\",\"body\":$body_escaped}")

    if echo "$response" | grep -q '"success":true'; then
        echo -e "${GREEN}✓ Email sent successfully${NC}"
        return 0
    else
        echo -e "${RED}✗ Failed to send email${NC}"
        echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
        return 1
    fi
}

cmd_send_file() {
    local to=""
    local subject=""
    local file=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to) to="$2"; shift 2 ;;
            --subject) subject="$2"; shift 2 ;;
            --file) file="$2"; shift 2 ;;
            *) echo -e "${RED}Unknown option: $1${NC}" >&2; exit 1 ;;
        esac
    done

    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo -e "${RED}Error: --file required and must exist${NC}" >&2
        exit 1
    fi

    body=$(cat "$file")
    cmd_send --to "$to" --subject "$subject" --body "$body"
}

cmd_check() {
    echo -e "${BLUE}→ Checking for new messages...${NC}"
    
    local response=$(curl -s -H "X-Api-Key: $API_KEY" "$API_BASE/check")

    if echo "$response" | grep -q '"success":true'; then
        local count=$(echo "$response" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("count", 0))' 2>/dev/null || echo "0")
        echo -e "${GREEN}✓ You have $count message(s)${NC}"
        
        if [ "$count" -gt 0 ]; then
            echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
        fi
    else
        echo -e "${YELLOW}! Check completed (no new messages or check failed)${NC}"
    fi
}

cmd_status() {
    echo -e "${BLUE}→ Checking account status...${NC}"
    
    local response=$(curl -s -H "X-Api-Key: $API_KEY" "$API_BASE/status" 2>/dev/null || echo '{"success":false}')

    echo -e "${GREEN}Account: maverick_machine@sendclaw.com${NC}"
    echo -e "${BLUE}API Key:${NC} ${API_KEY:0:8}...${API_KEY: -8}"
    
    # Try to get quota info from check endpoint
    local check_response=$(curl -s -H "X-Api-Key: $API_KEY" "$API_BASE/check")
    if echo "$check_response" | grep -q '"quota"'; then
        local quota=$(echo "$check_response" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(f"{d.get(\"used\", 0)}/{d.get(\"quota\", \"unknown\")} used")' 2>/dev/null)
        echo -e "${BLUE}Quota:${NC} $quota"
    fi
    
    echo -e "${BLUE}Rate limits:${NC} 5/day (unclaimed), 10/day (claimed), 25/day max"
    echo -e "${BLUE}Status:${NC} Private space mode (claim token: coral-9207)"
}

cmd_help() {
    show_help
}

# Main dispatch
case "${1:-help}" in
    send) shift; cmd_send "$@" ;;
    send-file) shift; cmd_send_file "$@" ;;
    check) shift; cmd_check "$@" ;;
    status) shift; cmd_status "$@" ;;
    help|--help|-h) cmd_help ;;
    *) 
        echo -e "${YELLOW}Unknown command: $1${NC}"
        cmd_help
        exit 1
        ;;
esac
